    {
      "name": "Listar todos usuários",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Validar lista\", function () {\r",
              "\r",
              "    const response = pm.response.json();\r",
              "\r",
              "    pm.expect(pm.response.code).to.eql(200);\r",
              "\r",
              "    pm.expect(response.usuarios[0]).to.have.property(\"nome\");\r",
              "    pm.expect(response.usuarios[0]).to.have.property(\"email\");\r",
              "    pm.expect(response.usuarios[0]).to.have.property(\"password\");\r",
              "    pm.expect(response.usuarios[0]).to.have.property(\"administrador\");\r",
              "    pm.expect(response.usuarios[0]).to.have.property(\"_id\");\r",
              "\r",
              "});\r",
              "\r",
              "pm.test(\"Status é 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "\r",
              "const response = pm.response.json();\r",
              "\r",
              "const usuarios = response.usuarios;\r",
              "\r",
              "// escolhe usuário aleatório\r",
              "const usuarioAleatorio = usuarios[\r",
              "    Math.floor(Math.random() * usuarios.length)\r",
              "];\r",
              "\r",
              "// salva apenas o ID em variável global\r",
              "pm.environment.set(\"userID\", usuarioAleatorio._id);\r",
              "\r",
              "console.log(\"ID salvo:\", usuarioAleatorio._id);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              ""
            ],
