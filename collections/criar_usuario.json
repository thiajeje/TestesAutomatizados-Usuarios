    {
      "name": "Criar usuário - com sucesso",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "\r",
              "let index = Math.floor(Math.random() * 1001);\r",
              "pm.environment.set(\"emailRandom\", 'beth.ajeje_' + index + '@qa.com');\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Validar usuario\", function () {\r",
              "\r",
              "    const response = pm.response.json();\r",
              "\r",
              "    pm.expect(pm.response.code).to.eql(201);\r",
              "    pm.expect(response.message).to.eql(\"Cadastro realizado com sucesso\");\r",
              "    \r",
              "});"
