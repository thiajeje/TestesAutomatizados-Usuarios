        {
          "listen": "test",
          "script": {
            "exec": [
              "const responseJson = pm.response.json();\r",
              "\r",
              "// Salva o token em variável do ambiente\r",
              "pm.environment.set('tokenValido', responseJson.authorization);\r",
              "\r",
              "console.log('Token gerado!');\r",
              "\r",
              "\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
