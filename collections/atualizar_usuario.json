    {
      "name": "Criar usuário",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "let index = Math.floor(Math.random() * 1001);\r",
              "pm.environment.set(\"emailRandom\", 'beth.ajeje_' + index + '@qa.com');"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Validar usuario\", function () {\r",
              "\r",
              "    const response = pm.response.json();\r",
              "\r",
              "    pm.expect(pm.response.code).to.eql(201);\r",
              "    pm.expect(response.message).to.eql(\"Cadastro realizado com sucesso\");\r",
              "    pm.environment.set(\"userID\", response._id);\r",
              "    \r",
              "});\r",
              "\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
